total_employees']) * 100\n","dept_attrition['attrition_rate'] = dept_attrition['attrition_rate'].round(2)\n","\n","print(\" Attrition Rate over Departments\")\n","print(dept_attrition)"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"xRneWrKVP6K_","colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"status":"ok","timestamp":1793729282667,"user_tz":-240,"elapsed":7,"user":{"displayName":"Salima Dadashova","userId":"02015391648946278492"}},"outputId":"cb6c22a4-3456-43a4-9b4e-1449e9b97974"},"outputs":[{"output_type":"stream","name":"stdout","text":["1470\n","✓ There are no null values in the table, everything is clean.\n","\n","Attrition class balance (by count):\n","Attrition\n","No     1233\n","Yes     237\n","Name: count, dtype: int64\n","\n","Attrition class balance (in percentage %):\n","Attrition\n","No     83.877551\n","Yes    16.122449\n","Name: proportion, dtype: float64\n"]}],"source":["# Data Cleaning & Attrition Class Balance Check\n","\n","unique_employees = df['EmployeeNumber'].nunique()\n","print(unique_employees)\n","null_counts = df.isnull().sum()\n","problematic_nulls = null_counts[null_counts > 0]\n","\n","if len(problematic_nulls) > 0:\n","    print(problematic_nulls)\n","else:\n","    print(\"✓ There are no null values in the table, everything is clean.\")\n","\n","print(\"\\nAttrition class balance (by count):\")\n","print(df['Attrition'].value_counts())\n","\n","print(\"\\nAttrition class balance (in percentage %):\")\n","print(df['Attrition'].value_counts(normalize=True) * 100)"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"trud8bSNQQb7","colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"status":"ok","timestamp":1793729347623,"user_tz":-240,"elapsed":18,"user":{"displayName":"Salima Dadashova","userId":"02015391648946278492"}},"outputId":"549f5e15-a17e-4c26-d703-a11a3c95c5e5"},"outputs":[{"output_type":"stream","name":"stdout","text":["Total Employees: 1470\n","Total Attritions: 237\n","Overall Attrition Rate: 16.12%\n","\n","--- KPI Summary (Comparison by Status) ---\n","     Status  total_employees  avg_monthly_income  avg_years_at_company  \\\n","0  Retained             1233         6832.739659              7.369019   \n","1   Churned              237         4787.092827              5.130802   \n","\n","   avg_job_satisfaction  \n","0              2.778589  \n","1              2.468354  \n"]}],"source":["# high-level KPI summary & attrition overview\n","\n","df['attrition_flag'] = df['Attrition'].map({'Yes': 1, 'No': 0})\n","\n","kpi_summary = df.groupby('attrition_flag').agg(\n","    total_employees=('EmployeeNumber', 'count'),\n","    avg_monthly_income=('MonthlyIncome', 'mean'),\n","    avg_years_at_company=('YearsAtCompany', 'mean'),\n","    avg_job_satisfaction=('JobSatisfaction', 'mean')\n",").reset_index()\n","\n","kpi_summary['Status'] = kpi_summary['attrition_flag'].map({1: 'Churned', 0: 'Retained'})\n","\n","total_emp = len(df)\n","total_attrition = (df['attrition_flag'] == 1).sum()\n","attrition_rate = (total_attrition / total_emp) * 100\n","\n","print(f\"Total Employees: {total_emp}\")\n","print(f\"Total Attritions: {total_attrition}\")\n","print(f\"Overall Attrition Rate: {attrition_rate:.2f}%\\n\")\n","\n","print(\"--- KPI Summary (Comparison by Status) ---\")\n","print(kpi_summary[['Status', 'total_employees', 'avg_monthly_income', 'avg_years_at_company', 'avg_job_satisfaction']])"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":226},"executionInfo":{"elapsed":195,"status":"ok","timestamp":1793729582897,"user":{"displayName":"Salima Dadashova","userId":"02015391648946278492"},"user_tz":-240},"id":"o_KmH4u3XHl5","outputId":"bf2f6d43-e8c5-4c21-bf1a-b1c45a3b9371"},"outputs":[{"output_type":"stream","name":"stdout","text":["  OverTime  total_employees  attrition_count  attrition_rate\n","0       No             1054              110           10.44\n","1      Yes              416              127           30.53\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 600x400 with 1 Axes>"],"image/png":"\n"},"metadata":{}}],"source":["# grouping by overtime\n","\n","overtime_attrition = df.groupby('OverTime').agg(\n","    total_employees=('attrition_flag', 'count'),\n","    attrition_count=('attrition_flag', 'sum')\n",").reset_index()\n","\n","overtime_attrition['attrition_rate'] = (overtime_attrition['attrition_count'] / overtime_attrition['total_employees']) * 100\n","overtime_attrition['attrition_rate'] = overtime_attrition['attrition_rate'].round(2)\n","\n","print(overtime_attrition)\n","\n","plt.figure(figsize=(6,4))\n","plt.bar(overtime_attrition['OverTime'], overtime_attrition['attrition_rate'], color='#5cb85c', width=0.4)\n","plt.title('Attrition Rate % by OverTime', fontweight='bold')\n","plt.ylabel('Attrition Rate (%)')\n","for i in range(len(overtime_attrition)):\n","    v = overtime_attrition['attrition_rate'].iloc[i]\n","    plt.text(i, v + 0.5, f\"{v}%\", ha='center', fontweight='bold')\n","\n","plt.show()"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"bSlmtljBU_na"},"outputs":[],"source":["# grouping according to job roles\n","role_attrition = df.groupby('JobRole').agg(\n","    total_employees=('attrition_flag', 'count'),\n","    attrition_count=('attrition_flag', 'sum')\n",").reset_index()\n","\n","role_attrition['attrition_rate'] = (role_attrition['attrition_count'] / role_attrition['total_employees']) * 100\n","\n","role_attrition = role_attrition[role_attrition['total_employees'] >= 30]\n","\n","role_attrition['attrition_rate'] = role_attrition['attrition_rate'].round(2)\n","role_attrition = role_attrition.sort_values(by='attrition_rate', ascending=False)\n","\n","print(\"\\n--- Q5: JobRole üzrə Attrition Rate (İşçi sayı >= 30) ---\")\n","print(role_attrition)"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"FHkHFxOoRK5O"},"outputs":[],"source":["# average company tenur