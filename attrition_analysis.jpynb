n","1467                   2                       0                     3   \n","1468                   6                       0                     8   \n","1469                   3                       1                     2   \n","\n","      attrition_flag  \n","0                  1  \n","1                  0  \n","2                  1  \n","3                  0  \n","4                  0  \n","...              ...  \n","1465               0  \n","1466               0  \n","1467               0  \n","1468               0  \n","1469               0  \n","\n","[1470 rows x 36 columns]\n"]}],"source":["# q1_attrition_flag\n","q2_val=\"\"\"SELECT *,\n","       CASE WHEN Attrition = 'Yes' THEN 1 ELSE 0 END AS attrition_flag\n","FROM employees;\"\"\"\n","\n","df_q1_val = pd.read_sql_query(q2_val, conn)\n","print(df_q1_val)\n"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"B5sUCY0oC8ap"},"outputs":[],"source":["# q2_validation\n","q2_val = \"\"\"\n","SELECT\n","    COUNT(*) AS total_rows,\n","    COUNT(DISTINCT EmployeeNumber) AS distinct_employees,\n","    SUM(CASE WHEN EmployeeNumber IS NULL THEN 1 ELSE 0 END) AS null_employee_number,\n","    SUM(CASE WHEN Department IS NULL THEN 1 ELSE 0 END) AS null_department,\n","    SUM(CASE WHEN MonthlyIncome IS NULL THEN 1 ELSE 0 END) AS null_monthly_income\n","FROM employees\n","\"\"\"\n","df_q2_val = pd.read_sql_query(q2_val, conn)\n","\n","q2_bal = \"\"\"\n","SELECT\n","    Attrition,\n","    COUNT(*) AS count,\n","    ROUND(COUNT(*) * 100.0 / (SELECT COUNT(*) FROM employees), 2) AS percentage\n","FROM employees\n","GROUP BY Attrition\n","\"\"\"\n","df_q2_bal = pd.read_sql_query(q2_bal, conn)"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":119},"executionInfo":{"elapsed":226,"status":"ok","timestamp":1793656058024,"user":{"displayName":"Salima Dadashova","userId":"02015391648946278492"},"user_tz":-240},"id":"GhCCs2gqC_Ld","outputId":"01a77bd9-5d29-4cbf-9773-c3d01901b563"},"outputs":[{"data":{"image/png":"\n","text/plain":["<Figure size 800x400 with 1 Axes>"]},"metadata":{},"output_type":"display_data"}],"source":["# grouping by department\n","q4 = \"\"\"\n","SELECT\n","    Department,\n","    COUNT(*) AS total_employees,\n","    SUM(CASE WHEN Attrition = 'Yes' THEN 1 ELSE 0 END) AS attritions,\n","    ROUND(100.0 * SUM(CASE WHEN Attrition = 'Yes' THEN 1 ELSE 0 END) / COUNT(*), 2) AS attrition_rate\n","FROM employees\n","GROUP BY Department\n","ORDER BY attrition_rate DESC;\n","\"\"\"\n","\n","df_q4 = pd.read_sql_query(q4, conn)\n","\n","plt.figure(figsize=(8, 4))\n","plt.bar(df_q4['Department'], df_q4['attrition_rate'], color='#2b5c8f', width=0.5)\n","plt.title('Attrition Rate % by Department', fontweight='bold')\n","plt.ylabel('Attrition Rate (%)')\n","\n","for i, v in enumerate(df_q4['attrition_rate']):\n","    plt.text(i, v + 0.5, f\"{v}%\", ha='center', fontweight='bold')\n","\n","plt.show()"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":112},"executionInfo":{"elapsed":333,"status":"ok","timestamp":1793729744814,"user":{"displayName":"Salima Dadashova","userId":"02015391648946278492"},"user_tz":-240},"id":"frlYzvLHDNDs","outputId":"8ac075c5-1177-44a6-a489-6d11fc7450c1"},"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 900x500 with 1 Axes>"],"image/png":"\n"},"metadata":{}}],"source":["# q5_jobrole_attrition\n","q5 = \"\"\"\n","SELECT\n","    JobRole,\n","    COUNT(*) AS total_employees,\n","    SUM(CASE WHEN Attrition = 'Yes' THEN 1 ELSE 0 END) AS attritions,\n","    ROUND(CAST(SUM(CASE WHEN Attrition = 'Yes' THEN 1 ELSE 0 END) AS REAL) * 100 / COUNT(*), 2) AS attrition_rate\n","FROM employees\n","GROUP BY JobRole\n","HAVING COUNT(*) >= 30\n","ORDER BY attrition_rate DESC\n","\"\"\"\n","df_q5 = pd.read_sql_query(q5, conn)\n","\n","plt.figure(figsize=(9, 5))\n","plt.barh(df_q5['JobRole'], df_q5['attrition_rate'], color='#d9534f')\n","plt.title('Attrition Rate % by Job Role (Headcount >= 30)', fontweight='bold')\n","plt.xlabel('Attrition Rate (%)')\n","\n","for i in range(len(df_q5)):\n","    v = df_q5['attrition_rate'].iloc[i]\n","    plt.text(v + 0.5, i, f\"{v}%\", va='center', fontweight='bold')\n","\n","plt.show()\n"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"boRAmC0BEqfa"},"outputs":[],"source":["# q6_categorical_attrition\n","q6 = \"\"\"\n","SELECT 'OverTime' AS dimension, OverTime AS category, COUNT(*) AS total, SUM(CASE WHEN Attrition = 'Yes' THEN 1 ELSE 0 END) AS attritions, ROUND(CAST(SUM(CASE WHEN Attrition = 'Yes' THEN 1 ELSE 0 END) AS REAL)*100/COUNT(*),2) AS attrition_rate FROM employees GROUP BY OverTime\n","UNION ALL\n","SELECT 'MaritalStatus', MaritalStatus, COUNT(*), SUM(CASE WHEN Attrition = 'Yes' THEN 1 ELSE 0 END), ROUND(CAST(SUM(CASE WHEN Attrition = 'Yes' THEN 1 ELSE 0 END) AS REAL)*100/COUNT(*),2) FROM employees GROUP BY MaritalStatus\n","UNION ALL\n","SELECT 'BusinessTravel', BusinessTravel, COUNT(*), SUM(CASE WHEN Attrition = 'Yes' THEN 1 ELSE 0 END), ROUND(CAST(SUM(CASE WHEN Attrition = 'Yes' THEN 1 ELSE 0 END) AS REAL)*100/COUNT(*),2) FROM employees GROUP BY BusinessTravel\n","UNION ALL\n","SELECT 'Gender', Gender, COUNT(*), SUM(CASE WHEN Attrition = 'Yes' THEN 1 ELSE 0 END), ROUND(CAST(SUM(CASE WHEN Attrition = 'Yes' THEN 1 ELSE 0 END) AS REAL)*100/COUNT(*),2) FROM employees GROUP BY Gender\n","\"\"\"\n","df_q6 = pd.read_sql_query(q6, conn)"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"e0SBwCAqDfcf"},"outputs":[],"source":["# q7_tenure_bands\n","q7 = \"\"\"\n","WITH tenure_cte AS (\n","    SELECT *,\n","        CASE\n","            WHEN YearsAtCompany BETWEEN 0 AND 2 THEN '0-2'\n","            WHEN YearsAtCompany BETWEEN 3 AND 5 THEN '3-5'\n","            WHEN YearsAtCompany BETWEEN 6 AND 10 THEN '6-10'\n","            ELSE '11+'\n","        END AS tenure_band\n","    FROM employees\n",")\n","SELECT\n","    tenure_band,\n","    COUNT(*) AS total_employees,\n","    SUM(CASE WHEN Attrition = 'Yes' THEN 1 ELSE 0 END) AS attritions,\n","    ROUND(CAST(SUM(CASE WHEN Attrition = 'Yes' THEN 1 ELSE 0 END) AS REAL) * 100 / COUNT(*), 2) AS attrition_rate\n","FROM tenure_cte\n","GROUP BY tenure_band\n","ORDER BY tenure_band\n","\"\"\"\n","df_q7 = pd.read_sql_query(q7, conn)\n","\n","plt.figure(figsize=(8, 4))\n","plt.plot(df_q7['tenure_band'].astype(str), df_q7['attrition_rate'], marker='o', color='#4682b4', linewidth=2)\n","plt.title('attrition rate % by tenure band', fontweight='bold')\n","plt.xlabel('tenure band')\n","plt.ylabel('attrition rate (%)')\n","\n","for i in range(len(df_q7)):\n","    v = df_q7['attrition_rate'].iloc[i]\n","    plt.text(i, v + 0.5, f\"{v}%\", ha='center', fontweight='bold')\n","\n","plt.tight_layout()\n","plt.show()"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"AB3HVAodEZjp"},"outputs":[],"source":["# q8_income_quartiles\n","q8 = \"\"\"\n","WITH income_quartiles AS (\n","    SELECT *,\n","        NTILE(4) OVER (ORDER BY MonthlyIncome) AS income_quartile\n","    FROM employees\n",")\n","SELECT\n","    income_quartile,\n","    COUNT(*) AS total_employees,\n","    SUM(CASE WHEN Attrition = 'Yes' THEN 1 ELSE 0 END) AS attritions,\n","    ROUND(CAST(SUM(CASE WHEN Attrition = 'Yes' THEN 1 ELSE 0 END) AS REAL) * 100 / COUNT(*), 2) AS attrition_rate\n","FROM income_quartiles\n","GROUP BY income_quartile\n","ORDER BY income_quartile\n","\"\"\"\n","df_q8 = pd.read_sql_query(q8, conn)"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"AQOfgh_IFHt5"},"outputs":[],"source":["# q9_pivot_jobsatisfaction\n","q9 = \"\"\"\n","SELECT\n","    Department,\n","    ROUND(CAST(SUM(CASE WHEN JobSatisfaction = 1 AND Attrition = 'Yes' THEN 1 ELSE 0 END) AS REAL) * 100 / NULLIF(SUM(CASE WHEN JobSatisfaction = 1 THEN 1 ELSE 0 END), 0), 2) AS js_1_rate,\n","    ROUND(CAST(SUM(CASE WHEN JobSatisfaction = 2 AND Attrition = 'Yes' THEN 1 ELSE 0 END) AS REAL) * 100 / NULLIF(SUM(CASE WHEN JobSatisfaction = 2 THEN 1 ELSE 0 END), 0), 2) AS js_2_rate,\n","    ROUND(CAST(SUM(CASE WHEN JobSatisfaction = 3 AND Attrition = 'Yes' THEN 1 ELSE 0 END) AS REAL) * 100 / NULLIF(SUM(CASE WHEN JobSatisfaction = 3 THEN 1 ELSE 0 END), 0), 2) AS js_3_rate,\n","    ROUND(CAST(SUM(CASE WHEN JobSatisfaction = 4 AND Attrition = 'Yes' THEN 1 ELSE 0 END) AS REAL) * 100 / NULLIF(SUM(CASE WHEN JobSatisfaction = 4 THEN 1 ELSE 0 END), 0), 2) AS js_4_rate\n","FROM employees\n","GROUP BY Department\n","\"\"\"\n","df_q9 = pd.read_sql_query(q9, conn)"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"PowOezPxEeGo"},"outputs":[],"source":["# q10_pivot_worklifebalance\n","q10 = \"\"\"\n","SELECT\n","    Department,\n","    ROUND(CAST(SUM(CASE WHEN WorkLifeBalance = 1 AND Attrition = 'Yes' THEN 1 ELSE 0 END) AS REAL) * 100 / NULLIF(SUM(CASE WHEN WorkLifeBalance = 1 THEN 1 ELSE 0 END), 0), 2) AS wlb_1_rate,\n","    ROUND(CAST(SUM(CASE WHEN WorkLifeBalance = 2 AND Attrition = 'Yes' THEN 1 ELSE 0 END) AS REAL) * 100 / NULLIF(SUM(CASE WHEN WorkLifeBalance = 2 THEN 1 ELSE 0 END), 0), 2) AS wlb_2_rate,\n","    ROUND(CAST(SUM(CASE WHEN WorkLifeBalance = 3 AND Attrition = 'Yes' THEN 1 ELSE 0 END) AS REAL) * 100 / NULLIF(SUM(CASE WHEN WorkLifeBalance = 3 THEN 1 ELSE 0 END), 0), 2) AS wlb_3_rate,\n","    ROUND(CAST(SUM(CASE WHEN WorkLifeBalance = 4 AND Attrition = 'Yes' THEN 1 ELSE 0 END) AS REAL) * 100 / NULLIF(SUM(CASE WHEN WorkLifeBalance = 4 THEN 1 ELSE 0 END), 0), 2) AS wlb_4_rate\n","FROM employees\n","GROUP BY Department\n","\"\"\"\n","df_q10 = pd.read_sql_query(q10, conn)"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"9vie9ba5FMV-"},"outputs":[],"source":["# q11_risk_profiles\n","q11 = \"\"\"\n","WITH risk_base AS (\n","    SELECT OverTime,\n","        CASE\n","            WHEN YearsAtCompany BETWEEN 0 AND 2 THEN '0-2'\n","            WHEN YearsAtCompany BETWEEN 3 AND 5 THEN '3-5'\n","            WHEN YearsAtCompany BETWEEN 6 AND 10 THEN '6-10'\n","            ELSE '11+'\n","        END AS tenure_band,\n","        NTILE(4) OVER (ORDER BY MonthlyIncome) AS income_quartile,\n","        Attrition\n","    FROM employees\n",")\n","SELECT\n","    OverTime,\n","    tenure_band,\n","    income_quartile,\n","    COUNT(*) AS headcount,\n","    SUM(CASE WHEN Attrition = 'Yes' THEN 1 ELSE 0 END) AS attritions,\n","    ROUND(CAST(SUM(CASE WHEN Attrition = 'Yes' THEN 1 ELSE 0 END) AS REAL) * 100 / COUNT(*), 2) AS attrition_rate\n","FROM risk_base\n","GROUP BY OverTime, tenure_band, income_quartile\n","HAVING COUNT(*) >= 20\n","ORDER BY attrition_rate DESC\n","LIMIT 3\n","\"\"\"\n","df_q11 = pd.read_sql_query(q11, conn)"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"d-dVUsXOFR5R"},"outputs":[],"source":["# q12_correlation_input\n","q12 = \"\"\"\n","SELECT\n","    Attrition,\n","    ROUND(AVG(Age), 2) AS avg_age,\n","    ROUND(AVG(DailyRate), 2) AS avg_daily_rate,\n","    ROUND(AVG(DistanceFromHome), 2) AS avg_distance_from_home,\n","    ROUND(AVG(HourlyRate), 2) AS avg_hourly_rate,\n","    ROUND(AVG(MonthlyIncome), 2) AS avg_monthly_income,\n","    ROUND(AVG(MonthlyRate), 2) AS avg_monthly_rate,\n","    ROUND(AVG(NumCompaniesWorked), 2) AS avg_num_companies_worked,\n","    ROUND(AVG(PercentSalaryHike), 2) AS avg_percent_salary_hike,\n","    ROUND(AVG(TotalWorkingYears), 2) AS avg_total_working_years,\n","    ROUND(AVG(YearsAtCompany), 2) AS avg_years_at_company,\n","    ROUND(AVG(YearsInCurrentRole), 2) AS avg_years_in_current_role,\n","    ROUND(AVG(YearsSinceLastPromotion), 2) AS avg_years_since_last_promotion,\n","    ROUND(AVG(YearsWithCurrManager), 2) AS avg_years_with_curr_manager\n","FROM employees\n","GROUP BY Attrition\n","\"\"\"\n","df_q12 = pd.read_sql_query(q12, conn)"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"7qYWm7QjaWPh"},"outputs":[],"source":["# pbi_setup_and_kpis\n","\n","# Base calculated columns\n","df['attrition_flag'] = df['Attrition'].map({'Yes': 1, 'No': 0})\n","\n","conditions_tenure = [\n","    (df['YearsAtCompany'] >= 0) & (df['YearsAtCompany'] <= 2),\n","    (df['YearsAtCompany'] >= 3) & (df['YearsAtCompany'] <= 5),\n","    (df['YearsAtCompany'] >= 6) & (df['YearsAtCompany'] <= 10),\n","    (df['YearsAtCompany'] >= 11)\n","]\n","choices_tenure = ['0-2', '3-5', '6-10', '11+']\n","df['tenure_band'] = np.select(conditions_tenure, choices_tenure, default='Unknown')\n","\n","df['income_quartile'] = pd.qcut(df['MonthlyIncome'], q=4, labels=[1, 2, 3, 4])\n","\n","# Explicit KPI Measures\n","total_headcount = df['attrition_flag'].count()\n","total_attritions = df['attrition_flag'].sum()\n","attrition_rate_pct = round((total_attritions / total_headcount) * 100, 2)\n","avg_monthly_income = round(df['MonthlyIncome'].mean(), 2)\n","avg_years_at_company = round(df['YearsAtCompany'].mean(), 2)"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"xr7LiG7UEj6S"},"outputs":[],"source":["# page1_executive_overview\n","p1_dept = df.groupby('Department').agg(\n","    headcount=('attrition_flag', 'count'),\n","    attritions=('attrition_flag', 'sum')\n",").reset_index()\n","p1_dept['attrition_rate'] = ((p1_dept['attritions'] / p1_dept['headcount']) * 100).round(2)\n","\n","p1_role = df.groupby('JobRole').agg(\n","    headcount=('attrition_flag', 'count'),\n","    attritions=('attrition_flag', 'sum')\n",").reset_index()\n","p1_role = p1_role[p1_role['headcount'] >= 30]\n","p1_role['attrition_rate'] = ((p1_role['attritions'] / p1_role['headcount']) * 100).round(2)\n","p1_role = p1_role.sort_values(by='attrition_rate', ascending=False).reset_index(drop=True)\n","\n","p1_tenure = df.groupby('tenure_band').agg(\n","    headcount=('attrition_flag', 'count'),\n","    attritions=('attrition_flag', 'sum')\n",").reset_index()\n","p1_tenure['attrition_rate'] = ((p1_tenure['attritions'] / p1_tenure['headcount']) * 100).round(2)\n","\n","pivot_js = df.pivot_table(\n","    index='Department',\n","    columns='JobSatisfaction',\n","    values='attrition_flag',\n","    aggfunc=['count', 'sum']\n",")\n","matrix_js = (pivot_js['sum'] / pivot_js['count']) * 100\n","matrix_js = matrix_js.round(2).reset_index()"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"LHhjuQy6a-n0"},"outputs":[],"source":["# page2_segment_explorer\n","p2_segments = df.groupby(['Department', 'JobRole', 'OverTime', 'tenure_band', 'income_quartile']).agg(\n","    headcount=('attrition_flag', 'count'),\n","    attritions=('attrition_flag', 'sum')\n",").reset_index()\n","\n","p2_segments['attrition_rate'] = ((p2_segments['attritions'] / p2_segments['headcount']) * 100).round(2)\n","segment_explorer = p2_segments.sort_values(by='attrition_rate', ascending=False).reset_index(drop=True)"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"ZjIfHAOzbBGX"},"outputs":[],"source":["# cross_validation_check\n","# Selecting top 3 segments to cross-validate headcount and rates explicitly\n","cross_val_sample = segment_explorer.head(3)"]}],"metadata":{"colab":{"provenance":[],"authorship_tag":"ABX9TyMG7fVIvqd1HJl3Cip2rFcN"},"kernelspec":{"display_name":"Python 3","name":"python3"},"language_info":{"name":"python"}},"nbformat":4,"nbformat_minor":0}